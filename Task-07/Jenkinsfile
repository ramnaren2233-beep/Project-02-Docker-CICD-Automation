pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
    }

    environment {
        DOCKER_USER = 'naren2026aws'
        IMAGE_NAME = 'kanban-dashboard'
    }

    stages {

        stage('checkout source') {
            steps {
                checkout scm
            }
        }

        stage('docker build') {
            steps {
                sh "docker build -f Task-07/Dockerfile -t \${DOCKER_USER}/${IMAGE_NAME}:${BUILD_NUMBER} Task-07/"
            }
        }

        stage('registry login and push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'docker-hub-credentials',
                        usernameVariable: 'USER',
                        passwordVariable: 'PASS'
                    )
                ]) {
                    sh 'echo "$PASS" | docker login -u "$USER" --password-stdin'
                    sh "docker push ${DOCKER_USER}/${IMAGE_NAME}:${BUILD_NUMBER}"
                }
            }
        }

        stage('deploy to EC2') {
            steps {
                sh "docker stop ${IMAGE_NAME}-container || true"
                sh "docker rm ${IMAGE_NAME}-container || true"
                sh "docker run -d -p 80:80 --name ${IMAGE_NAME}-container ${DOCKER_USER}/${IMAGE_NAME}:${BUILD_NUMBER}"
            }
        }

        stage('health check') {
            steps {
                sleep 5
                sh 'curl -f http://localhost:80'
            }
        }
    }

    post {
        success {
            echo 'Pipeline successfully completed! Container is healthy.'
        }

        failure {
            echo 'Pipeline failed.'
        }
    }
}
